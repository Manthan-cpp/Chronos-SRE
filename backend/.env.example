# Chronos-SRE Environment Configuration
# Copy this to .env in your backend folder

# 1. Nebius Token Factory API Key (studio.nebius.ai)
# Used for high-throughput streaming of nvidia/llama-3.1-nemotron-70b-instruct
NEBIUS_API_KEY=your_nebius_token_factory_key_here
NEBIUS_BASE_URL=https://api.studio.nebius.ai/v1/
NEMOTRON_MODEL=nvidia/llama-3.1-nemotron-70b-instruct

# 2. Tavily Search API Key (tavily.com)
# Used for live real-time GitHub issues & package errata grounding
TAVILY_API_KEY=your_tavily_api_key_here

# 3. GitHub Personal Access Token (github.com -> Settings -> Developer Settings)
# Used for autonomous verified Pull Request creation (Requires 'repo' scope)
GITHUB_TOKEN=your_github_pat_here
GITHUB_DEFAULT_REPO=owner/repo_name

# Server Configuration
PORT=8000
HOST=0.0.0.0
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
